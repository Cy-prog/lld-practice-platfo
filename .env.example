# Evaluator Mode: 'gemini' (uses Google Gemini API) or 'mock' (deterministic, realistic offline evaluator)
EVALUATOR_MODE=mock

# Google Gemini API Key (optional if EVALUATOR_MODE is 'mock', required for 'gemini')
# Get one at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-2.5-flash, supports gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server Port
PORT=3000
